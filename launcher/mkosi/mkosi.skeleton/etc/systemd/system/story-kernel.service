# story-kernel.service — the DKG kernel itself.  Starts only after the
# full measurement chain (swtpm → PCR 12 → RTMR3) has completed.

[Unit]
Description=story-kernel DKG node
After=story-kernel-rtmr3-extend.service network-online.target
Requires=story-kernel-rtmr3-extend.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/story-kernel
Restart=on-failure
RestartSec=5s
# Drop all privileges the binary does not need.  story-kernel speaks gRPC
# over a unix socket to the consensus client; it does not need raw network
# admin, module loading, or filesystem mutation outside its data dir.
User=story-kernel
Group=story-kernel
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=no
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/story-kernel

[Install]
WantedBy=multi-user.target
