# story-kernel-measure-binary.service — extend PCR 12 with the SHA-256 of
# the story-kernel ELF.  Must run BEFORE story-kernel itself.
#
# This is the binding step for PolicyPCR-based sealing: the kernel binary
# can only unseal material that was originally sealed against the exact
# PCR 12 value its hash produces.  Operators swapping in a modified ELF
# at runtime will see PCR 12 mismatch and sealing will fail closed.
#
# Sealing targets the platform vTPM at /dev/tpmrm0 (on GCP confidential VMs
# the firmware-backed vTPM that also populates PCR 7/11); AssertPathExists
# makes the unit fail loud on a host without it rather than measure nothing.

[Unit]
Description=Extend PCR 12 with story-kernel ELF measurement
DefaultDependencies=no
Before=story-kernel-rtmr3-extend.service story-kernel.service
AssertPathExists=/usr/local/bin/story-kernel
AssertPathExists=/dev/tpmrm0

[Service]
User=story-kernel
Group=story-kernel
PrivateDevices=no
DeviceAllow=char-tpm rw
StandardOutput=journal+console
StandardError=journal+console
Type=oneshot
RemainAfterExit=yes
# No TPM2TOOLS_TCTI: tpm2-tools auto-detects /dev/tpmrm0, the same kernel TPM
# device story-kernel seals against (enclave/tdx/seal.go). Extending PCR 12 on
# that device (not a side channel) is what keeps the sealing PCR view coherent.
ExecStart=/usr/local/lib/story-kernel/measure-binary.sh /usr/local/bin/story-kernel 12
# If the measurement fails we MUST NOT proceed.  The story-kernel binary
# is only safe to run if PCR 12 reflects its identity.
SuccessExitStatus=0
NoNewPrivileges=yes
ProtectSystem=strict
# measure-binary.sh writes a scratch file under /tmp to read back the
# post-extend PCR value; ProtectSystem=strict makes the real /tmp read-only,
# so give the unit a private writable /tmp (matches story-kernel.service).
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateNetwork=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=basic.target
