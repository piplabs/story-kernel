# story-kernel-swtpm.service — in-TD swtpm emulating PCRs in the TD's
# encrypted memory.  Started before any process that needs sealing.
#
# The state directory lives on the (verity-protected) rootfs but its
# contents are wiped at every boot — sealed material is re-bound to PCRs
# fresh per boot.  This is intentional: persisting swtpm state across
# reboots would let an operator capture state from a hostile reboot and
# replay it.

[Unit]
Description=story-kernel in-TD software TPM
DefaultDependencies=no
Before=story-kernel-rtmr3-extend.service story-kernel-measure-binary.service story-kernel.service
# DefaultDependencies=no drops the implicit ordering after sysinit.target, so we
# must order explicitly after module load: tpm_vtpm_proxy (loaded via
# modules-load.d / initrd) is what creates /dev/vtpm-proxy, which the
# AssertPathExists below now hard-requires.
After=systemd-tmpfiles-setup.service systemd-modules-load.service
AssertPathExists=/dev/vtpm-proxy
RequiresMountsFor=/run/story-kernel-swtpm

[Service]
Type=notify
NotifyAccess=all
RuntimeDirectory=story-kernel-swtpm
RuntimeDirectoryMode=0700
# --tpm2: emulate a TPM 2.0 device.
# --tpmstate dir=...: state lives in tmpfs RuntimeDirectory (cleared at reboot).
# --ctrl: control socket for swtpm_setup and tpm2_* tools.
# --server: data socket consumed by the kernel vTPM proxy.
# --flags not-need-init: PCRs start zeroed; we extend them explicitly.
ExecStart=/usr/bin/swtpm chardev \
        --tpm2 \
        --tpmstate dir=/run/story-kernel-swtpm \
        --ctrl type=unixio,path=/run/story-kernel-swtpm/ctrl \
        --server type=unixio,path=/run/story-kernel-swtpm/server \
        --flags not-need-init,startup-clear \
        --vtpm-proxy
Restart=no
# No restart: swtpm losing state mid-flight means PCRs are gone, which
# means any sealed material that was bound to them is unrecoverable.
# A halt is safer than a silent restart that re-runs measurement.
KillMode=mixed
TimeoutStartSec=10
TimeoutStopSec=5
# Hardening: swtpm should not be able to do anything other than emulate
# the TPM.  These restrictions mirror the launcher/hardening/ policies.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=no
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=basic.target
